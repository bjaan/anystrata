// vulkan/src/kernels/mmvq_iq2_s.comp - native_mmvq for ggml_type 22 (IQ2_S).
//
// Transcription of src/kernels/cuda/iq_kernels.cu's launch_mmvq<22> default path
// (mmvq_kernel<TY=22>, block(32,4), grid ceil(n_out/4)) with Fmt<22> = {qk 256, ipb 8, step 2}
// (iq_kernels.cu:621), row_dot (668-677), warp_sum (661-665) and vec_dot_iq2_s_q8_1
// (iq_kernels.cu:158-189; the CUDA/llama.cpp reference vecdotq.cuh:1124-1167 is identical).
// iq_kernels.cu:699-701 pins every column of mmvq_kernel bitwise-equal to the same column of
// mmvq_multi_kernel (what the CUDA build runs via iq_mmvq), so this per-column transcription
// matches the CUDA answer bitwise (the parity test asserts it).
//
// Workgroup 128 = 4 subgroups of 32 (force_subgroup32; the tree's warp laws): subgroup lane =
// tid%32, subrow = tid/32; row = group*4 + subrow, so `row >= n_out` returns whole subgroups and
// every shuffle partner stays active.
//
// block_iq2_s is 82 bytes (ggml-common.h:396-402: half d + uint8 qs[QK_K/4=64] + uint8 qh[8] +
// uint8 scales[8]) - NOT 4-aligned, so W is uint words and every field is assembled byte-by-byte
// (wb/w16). Layout: d @0-1, qs @2..65 (the low 6 bits per value: grid bytes for sub-block iqs/2
// at 2+2*iqs, the 2-bit sign bytes for the same pair at 34+2*iqs - get_int_b2(qs, 8 + iqs/2)),
// qh @66..73 (the 2 high bits per value, byte iqs/2), scales @74..81 (byte iqs/2: ls0 low nibble,
// ls1 high nibble). block_q8_1 is 36 B = 9 words (word 0 = ds, low half d; words 1..8 = qs[0..31]).
//
// The CUDA SIMD ops are emulated exactly, 4 scalar byte lanes each:
//   __vcmpne4(a,0)    per byte != 0 -> 0xFF else 0
//   __vsub4(a,b)      per byte (a_i - b_i) & 0xFF (no cross-byte borrow)
//   ggml_cuda_dp4a    signed byte-dot of 4 pairs into acc (exact int32; the dp4a route is a later
//                     optimization, as in the iq2_xxs/iq3_xxs headers)
//   (sumi0*ls0 + sumi1*ls1 + (sumi0+sumi1)/2)/4   C truncation toward zero on BOTH divisions ->
//                     trunc_div2 / trunc_div4 spelled by hand.
// iq2s_grid is 1024 x uint64 (ggml-common.h:758), indexed by the 10-bit composite
// qs[l0/2] | ((qh << (8-l0)) & 0x300): grid_pos[0]/[1] are the low/high 32-bit halves, so the
// table binds as buffer 3 uvec2 pairs (low first, like iq2xxs_grid_vk.h), uploaded once by the
// launcher (8192 B to the arena; the CPU build makes it static-per-TU, no linkable symbol).
//
// Contraction probe (Task 2.13 law): the row accumulator `s += dot(...)` is NOT fused by
// glslc/NIR into fma(dw*d8, sumi, s) on this device for this shape (the same evidence as
// iq2_xxs/iq3_xxs; the parity test pins the arm that goes 0-differ bitwise).
#version 450
#extension GL_KHR_shader_subgroup_basic : enable
#extension GL_KHR_shader_subgroup_shuffle : enable

layout(local_size_x = 128) in;

layout(std430, binding = 0) readonly buffer W    { uint  v[]; } bw;   // IQ2_S blocks, 82 B each
layout(std430, binding = 1) readonly buffer X    { uint  v[]; } bx;   // q8_1 columns, 36 B blocks
layout(std430, binding = 2)           buffer Y    { float v[]; } by;   // ncols * n_out floats
layout(std430, binding = 3) readonly buffer Grid { uvec2 v[]; } bg;   // iq2s_grid: 1024 x (low32, high32)

layout(push_constant) uniform PC { uint n_in; uint n_out; uint ncols; } pc;

// one byte of W at byte offset B (blocks are 82 B = not 4-aligned)
uint wb(uint B) { return (bw.v[B >> 2u] >> (8u * (B & 3u))) & 0xFFu; }

uint vcmpne4(uint a) {
    uint r = 0u;
    for (uint i = 0u; i < 4u; ++i)
        r |= (((a >> (8u * i)) & 255u) != 0u ? 255u : 0u) << (8u * i);
    return r;
}
uint vsub4(uint a, uint b) {
    uint r = 0u;
    for (uint i = 0u; i < 4u; ++i)
        r |= (((a >> (8u * i)) - (b >> (8u * i))) & 255u) << (8u * i);
    return r;
}
int sbyte(uint a, uint i) {
    const uint b = (a >> (8u * i)) & 255u;
    return b >= 128u ? int(b) - 256 : int(b);
}
int dp4a(int a, int b, int c) {
    for (uint i = 0u; i < 4u; ++i) c += sbyte(uint(a), i) * sbyte(uint(b), i);
    return c;
}
// C's x / 2 and x / 4 (truncation toward zero; both operands can be negative, |x| << 2^31)
int trunc_div2(int x) { return x >= 0 ? x / 2 : -( (-x) / 2 ); }
int trunc_div4(int x) { return x >= 0 ? x / 4 : -( (-x) / 4 ); }

// vec_dot_iq2_s_q8_1(bq2 = row block kbx, bq8_1 = x column + kbx*8 + iqs/2, iqs) - same ops, same order.
float iq2_s_dot(uint b0, uint xw, uint kbx, uint iqs) {
    const uint blk = b0 + kbx * 82u;
    const uint qsb  = blk + 2u;                       // qs[0] (64 bytes: grid + sign halves)
    const uint qh   = wb(blk + 66u + (iqs >> 1u));    // bq2->qh[iqs/2]
    const uint ls   = wb(blk + 74u + (iqs >> 1u));    // bq2->scales[iqs/2]
    const int ls0 = int(ls & 0x0Fu);
    const int ls1 = int(ls >> 4u);
    int sumi0 = 0;
    int sumi1 = 0;
    const uint xw0 = xw + (kbx * 8u + iqs / 2u) * 9u;
    for (uint l0 = 0u; l0 < 8u; l0 += 2u) {
        const uint au = l0 >> 1u;                                 // qs[l0/2], sp8[l0/2] byte index
        const uint q  = wb(qsb + 4u * (iqs >> 1u) + au);          // qs_packed byte au
        const uint sp = wb(qsb + 32u + 4u * (iqs >> 1u) + au);    // signs_packed_8 byte au
        const uint idx = q | ((qh << (8u - l0)) & 0x300u);
        const uvec2 gp = bg.v[idx];                               // grid_pos[0], grid_pos[1]
        const uint sgn0 = vcmpne4(((sp & 0x03u) << 7u) | ((sp & 0x0Cu) << 21u));
        const uint sgn1 = vcmpne4(((sp & 0x30u) << 3u) | ((sp & 0xC0u) << 17u));
        const uint gl = vsub4(gp.x ^ sgn0, sgn0);
        const uint gh = vsub4(gp.y ^ sgn1, sgn1);
        const int u0 = int(bx.v[xw0 + 1u + l0]);                  // get_int_b4(qs, l0)
        const int u1 = int(bx.v[xw0 + 1u + l0 + 1u]);
        if (l0 < 4u) {
            sumi0 = dp4a(int(gl), u0, sumi0);
            sumi0 = dp4a(int(gh), u1, sumi0);
        } else {
            sumi1 = dp4a(int(gl), u0, sumi1);
            sumi1 = dp4a(int(gh), u1, sumi1);
        }
    }
    const int sumi = trunc_div4(sumi0 * ls0 + sumi1 * ls1 + trunc_div2(sumi0 + sumi1));
    // __half2float(bq2->d) * __low2float(ds), then * sumi (same association as CUDA)
    const float dw = unpackHalf2x16(wb(blk) | (wb(blk + 1u) << 8u)).x;
    const float d8 = unpackHalf2x16(bx.v[xw0]).x;
    return dw * d8 * float(sumi);
}

void main() {
    const uint tid  = gl_GlobalInvocationID.x;
    const uint lane = tid & 31u;
    // CUDA row = blockIdx.x*4 + threadIdx.y: the subrow is the LOCAL 128-thread index / 32.
    const uint row  = gl_WorkGroupID.x * 4u + ((tid & 127u) >> 5u);
    if (row >= pc.n_out) return;                   // whole 32-lane subgroups leave together
    const uint nb = pc.n_in / 256u;
    const uint b0 = row * nb * 82u;
    for (uint c = 0u; c < pc.ncols; ++c) {
        const uint xw = c * nb * 72u;              // column c: nb*8 blocks x 9 words
        float s = 0.0;
        for (uint k = lane; k < nb * 8u; k += 32u)          // Fmt<22>: ipb 8, step 2
            s += iq2_s_dot(b0, xw, k / 8u, 2u * (k % 8u));
        for (uint o = 16u; o > 0u; o >>= 1u)                // warp_sum's xor tree, 16,8,4,2,1
            s += subgroupShuffleXor(s, o);
        if (lane == 0u) by.v[c * pc.n_out + row] = s;
    }
}
