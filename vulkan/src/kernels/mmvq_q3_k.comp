// vulkan/src/kernels/mmvq_q3_k.comp - native_mmvq for ggml_type 11 (Q3_K).
//
// Line-by-line translation of src/kernels/cuda/native_mmvq.cu's native_q3_k_mmvq (2810-2835):
// the ncols == 1 path is native_q3_k_mmvq_kernel<SmallK> (463-499). The partition is the Q2_K
// shape (which is itself documented as "as Q3_K"): QK=256, QI=16, VDR=1, kqs = tid % 16,
// kbx = tid/16 stepping BLOCKS_PER_ITER = WARPS*WARP/16 = 8, and the SmallK pick (:2828) is
// n_in/256 < 8 -> ROWS=4 (grid ceil(n_out/4)), else ROWS=1 (grid n_out). launch_multi<Q3KTraits>
// (ncols>1, :2820) is pinned bitwise-equal per column, so the c loop below answers every ncols
// exactly as the CUDA multi kernel does (q2_k/q4_k precedent).
//
// The dot is q3_q8_dot (445-460) + q3_q8_dot_impl (422-443) verbatim: same word indices, same
// scale-offset arithmetic, same i order 0..3, same float accumulation. Q3KBlock (79-84,
// static_asserts :132-133): hmask[32]@0, qs[64]@32, scales[12]@96, half d@108 = 110 bytes,
// alignof 2. 110 % 4 = 2: like Q6_K's 210 B, a row-major block stream is NOT 4-aligned, so W is
// read byte-by-byte from uint words (wb/w16/rd32, the q6_k precedent); load_int_b2(ptr, i32) =
// two uint16 LE loads = a plain 4-byte LE read at byte 4*i32 from the field base.
//
// 3-bit code assembly: vl = load_int_b2(qs, iqs) gives the low 2 bits per lane (0x03030303
// masks), vh = ~load_int_b2(hmask, iqs % 8) >> bq8_offset carries the high bit; the bits kept
// after `((vh >> i) << 2) & 0x04040404` never cross bit 31 (max source bit index 8*3 + 2 + 4 =
// 30), so GLSL's arithmetic >> on int is bit-exact. __vsubss4 needs no saturation clamp:
// vil bytes <= 3, vih bytes in {0, 4}, so each byte lands in [-4, 3], inside int8 (q6_k's
// vsub4 per-byte subtract is bit-exact).
//
// Contraction law (PORT-NOTES "RADV arithmetic gotchas" #6, the q6_k-lineage fusion proven
// bitwise by the type-14 parity suite): CUDA builds with --use_fast_math and no
// -ffp-contract=off, so the dot's `sumf += d8[i] * (DP4A(vi, u[i], 0) * sc)` accumulates via
// fma(d8, dot*sc, sumf), and the kernel's `tmp[i] += q3_q8_dot(...)` - the dot returns the
// plain product d * sumf - fuses to fma(d, sumf, tmp). glslc keeps OpFMul+OpFAdd and RADV's NIR
// fuses to exactly that; the parity test's host reference spells std::fma in the same order.
#version 450
#extension GL_KHR_shader_subgroup_basic : enable
#extension GL_KHR_shader_subgroup_shuffle : enable

layout(local_size_x = 128) in;

layout(std430, binding = 0) readonly buffer W    { uint  v[]; } bw;   // Q3_K blocks, 110 B each
layout(std430, binding = 1) readonly buffer X    { uint  v[]; } bx;   // q8_1 columns, 9 words/block
layout(std430, binding = 2)           buffer Y    { float v[]; } by;   // ncols * n_out floats

layout(push_constant) uniform PC { uint n_in; uint n_out; uint ncols; uint rows; } pc;

uint wb(uint B) { return (bw.v[B >> 2u] >> (8u * (B & 3u))) & 0xFFu; }
uint w16(uint B) { return wb(B) | (wb(B + 1u) << 8u); }
int  rd32(uint B) { return int(wb(B) | (wb(B + 1u) << 8u) | (wb(B + 2u) << 16u) | (wb(B + 3u) << 24u)); }  // load_int_b2 pair = plain 4-byte LE
int  sbyte(uint a, uint i) { const uint b = (a >> (8u * i)) & 255u; return b >= 128u ? int(b) - 256 : int(b); }
int  vsub4(int a, int b) {   // __vsubss4 byte-lane subtract; results here fit int8 ([-4,3]), no clamp
    int r = 0;
    for (uint i = 0u; i < 4u; ++i)
        r |= int((((uint(a) >> (8u * i)) & 255u) - ((uint(b) >> (8u * i)) & 255u)) & 255u) << (8u * i);
    return r;
}
int  dp4a(int a, int b, int c) { for (uint i = 0u; i < 4u; ++i) c += sbyte(uint(a), i) * sbyte(uint(b), i); return c; }

// q3_q8_dot(w + block, x + kby, iqs) - wbase is the block's BYTE offset in W, xw the q8
// column's WORD offset in X for kby (x + kby). Returns the d * sumf product (445-460).
float q3_k_dot(uint wbase, uint xw, uint iqs) {
    const uint bq8_offset   = 4u * (iqs / 8u);
    const uint scale_offset = iqs - (iqs % 8u) + (iqs % 8u) / 4u;
    const float d = unpackHalf2x16(w16(wbase + 108u)).x;               // w->d (half, q449)
    const int vl = rd32(wbase + 32u + 4u * iqs);                       // load_int_b2(qs, iqs)
    const int vh = ~rd32(wbase + 4u * (iqs % 8u)) >> int(bq8_offset);  // ~load_int_b2(hmask, iqs%8) >> bq8
    float sumf = 0.0;
    for (uint i = 0u; i < 4u; ++i) {
        // scales are indexed against w->scales (base, no offset pointer): isc = scale_offset + 2i,
        // low nibble from scales[isc % 8], top 2 bits from scales[8 + isc % 4] (impl :428-436).
        const uint isc = scale_offset + 2u * i;
        const uint sc_low  = (wb(wbase + 96u + (isc % 8u)) >> (4u * (isc / 8u))) & 0xFu;
        const uint sc_high = ((wb(wbase + 104u + (isc % 4u)) >> (2u * (isc / 4u))) & 3u) << 4u;
        const int  sc = int(sc_low | sc_high) - 32;
        const int  vil = (vl >> int(2u * i)) & 0x03030303;
        const int  vih = ((vh >> int(i)) << 2) & 0x04040404;
        const int  vi  = vsub4(vil, vih);
        const uint xb  = xw + (bq8_offset + i) * 9u;                   // x[bq8_offset + i]
        const int  u   = int(bx.v[xb + 1u + (iqs % 8u)]);              // (int*)qs[iqs % 8]
        const float d8 = unpackHalf2x16(bx.v[xb]).x;                   // __low2float(ds)
        sumf += d8 * float(dp4a(vi, u, 0) * sc);                       // -> fma (contract, law 6)
    }
    return d * sumf;
}

// double-buffered across columns (max 8) so each c's reduction reads only its own writes
shared float sh[8][4][4][32];

void main() {
    const uint tid    = gl_LocalInvocationID.x;      // CUDA tid = 32*threadIdx.y + threadIdx.x
    const uint lane   = tid & 31u;
    const uint subrow = tid >> 5u;                   // threadIdx.y
    const uint nb     = pc.n_in / 256u;              // blocks_per_row
    const uint row0   = (pc.rows == 4u) ? gl_WorkGroupID.x * 4u : gl_WorkGroupID.x;
    const uint kqs    = tid % 16u;                   // VDR = 1
    const uint maxc   = min(pc.ncols, 8u);
    for (uint c = 0u; c < maxc; ++c) {
        float t0 = 0.0, t1 = 0.0, t2 = 0.0, t3 = 0.0;
        const uint xc = c * (nb * 8u) * 9u;          // column c's x base (words)
        for (uint kbx = tid / 16u; kbx < nb; kbx += 8u) {   // BLOCKS_PER_ITER = WARPS*WARP/16
            const uint xb = xc + kbx * 8u * 9u;      // kby = kbx * QK/Q8K q8 blocks
            const uint wb0 = kbx * 110u;
            // inner `for (i = 0; i < ROWS; ++i)` in the same order; the row guard keeps the
            // partial-row-group read in-bounds exactly like the CUDA source.
            if (pc.rows == 1u) {
                t0 += q3_k_dot(row0 * nb * 110u + wb0, xb, kqs);
            } else {
                if (row0 + 0u < pc.n_out) t0 += q3_k_dot((row0 + 0u) * nb * 110u + wb0, xb, kqs);
                if (row0 + 1u < pc.n_out) t1 += q3_k_dot((row0 + 1u) * nb * 110u + wb0, xb, kqs);
                if (row0 + 2u < pc.n_out) t2 += q3_k_dot((row0 + 2u) * nb * 110u + wb0, xb, kqs);
                if (row0 + 3u < pc.n_out) t3 += q3_k_dot((row0 + 3u) * nb * 110u + wb0, xb, kqs);
            }
        }
        sh[c][subrow][0u][lane] = t0;
        if (pc.rows == 4u) {           // ROWS=1: CUDA partial[..][i>0] is never written; keep the
            sh[c][subrow][1u][lane] = t1;   // slots untouched (zero) so the sum stays exact.
            sh[c][subrow][2u][lane] = t2;
            sh[c][subrow][3u][lane] = t3;
        }
        groupMemoryBarrier(); barrier();
        // CUDA :490-497: warp 0 only sums tmp + partial[l] l = 0..WARPS-2 ascending, then warp_sum.
        if (subrow == 0u) {
            for (uint i = 0u; i < pc.rows; ++i) {
                float acc = sh[c][0u][i][lane];
                acc = acc + sh[c][1u][i][lane];
                acc = acc + sh[c][2u][i][lane];
                acc = acc + sh[c][3u][i][lane];
                for (uint o = 16u; o > 0u; o >>= 1u) acc += subgroupShuffleXor(acc, o);   // warp_sum tree
                if (lane == i && row0 + i < pc.n_out) by.v[c * pc.n_out + row0 + i] = acc;
            }
        }
        groupMemoryBarrier(); barrier();             // next c must not race this c's reads
    }
}
