// vulkan/src/poly/kernels/rms_norm.comp - the poly RMS norm, one workgroup a row.
//
// The line-by-line translation of src/poly/kernels.cu's rms_norm_kernel (lines 159-169) with its
// block_sum helper (42-50) and WARP = 32:
//   for (i = tid; i < n; i += blockDim) ss += xr[i]*xr[i];  strided loop, same per-thread order
//   warp_sum: __shfl_xor chain offsets 16,8,4,2,1        ->  subgroupShuffleXor 16..1 in the SAME
//                                                            order; offsets <= 16 never cross a
//                                                            32-lane aligned block, so the value is
//                                                            per-warp whether the subgroup runs 32
//                                                            or 64 wide on gfx1013;
//   (threadIdx.x & 31)==0 -> part[threadIdx.x >> 5]      same with gl_LocalInvocationID.x (the
//                                                            workgroup index, not the subgroup one);
//   s = part[0] + ... + part[blockDim/32 - 1] IN ORDER;  scale = 1.0f / sqrtf(ss / float(n) + eps);
//   y = w ? x*scale*w : x*scale                           left-to-right product (x*scale)*w.
// The workgroup size IS sum_threads(n) as the CUDA launcher picks it (128/256/512/1024): the build
// compiles one .spv per size (glslc -DRMS_THREADS=N), so the strided loop's iteration counts - the
// thing fp sums turn on - match the CUDA block exactly.
//
// fp32 contraction caveat: glslc keeps a*b+c separate unless -O contracts and RADV may contract in
// its own compiler; the parity test's rel 1e-5 is the contract (PORT-STATUS tolerance law).
#version 450
#extension GL_KHR_shader_subgroup_basic : enable
#extension GL_KHR_shader_subgroup_shuffle : enable

layout(local_size_x = RMS_THREADS) in;

layout(std430, binding = 0) readonly buffer X { float v[]; } bx;   // rows x n, contiguous
layout(std430, binding = 1) readonly buffer W { float v[]; } bw;   // n weights; bound as X when w is null
layout(std430, binding = 2) buffer Y { float v[]; } by;            // rows x y_stride

layout(push_constant) uniform PC { uint n; uint y_stride; uint has_w; uint eps_bits; } pc;

shared float part[RMS_THREADS / 32];

void main() {
    const uint row = gl_WorkGroupID.x;
    const uint n = pc.n;
    const uint tid = gl_LocalInvocationID.x;
    const uint base = row * n;
    const uint obase = row * pc.y_stride;
    const float eps = uintBitsToFloat(pc.eps_bits);

    float ss = 0.0;
    for (uint i = tid; i < n; i += RMS_THREADS) {
        const float v = bx.v[base + i];
        ss += v * v;
    }
    // warp_sum: offsets 16, 8, 4, 2, 1 - the CUDA __shfl_xor chain's order, per warp.
    for (uint o = 16u; o > 0u; o >>= 1u) ss += subgroupShuffleXor(ss, o);
    if ((tid & 31u) == 0u) part[tid >> 5u] = ss;
    barrier();
    float s = 0.0;
    for (uint k = 0u; k < RMS_THREADS / 32u; ++k) s += part[k];
    barrier();

    const float scale = 1.0 / sqrt(s / float(n) + eps);
    for (uint i = tid; i < n; i += RMS_THREADS) {
        const float v = bx.v[base + i];
        by.v[obase + i] = pc.has_w != 0u ? (v * scale) * bw.v[i] : v * scale;
    }
}
