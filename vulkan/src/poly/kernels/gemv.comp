// vulkan/src/poly/kernels/gemv.comp - the poly fp32 GEMV, one workgroup an output row a token.
//
// Line-by-line translation of src/poly/kernels.cu's gemv_kernel<W> (lines 75-88) with block_sum
// (42-50) and WARP = 32:
//   for (i = tid; i < n_in; i += blockDim) acc += ldw(wr,i) * xr[i];  strided loop, same per-thread
//                                                                        order (fp32 contraction may
//                                                                        fuse to fma; see caveat);
//   warp_sum: __shfl_xor 16..1 -> subgroupShuffleXor 16..1 in the SAME order; offsets <= 16 never
//                                                                        cross a 32-lane aligned
//                                                                        block, so the per-warp sum
//                                                                        is identical whether the
//                                                                        subgroup runs 32 or 64 wide
//                                                                        on gfx1013 (same argument
//                                                                        as rms_norm.comp);
//   part[tid>>5] by the LOCAL invocation id, then part[0..threads/32) IN ORDER.
// The CUDA grid is dim3(n_out, rows); flattened to 1D here (groups_x = n_out*rows, o = gid % n_out,
// tok = gid / n_out) — blocks are independent, so the mapping cannot change any sum, and
// kernel_launch_sized dispatches x-only.
//
// The workgroup size IS the CUDA launcher's threads (n_in >= 128 ? sum_threads(n_in) : 32): the
// strided loop's iteration partition is part of the fp contract, so the build compiles one .spv per
// size (-DGEMV_THREADS=N) and the launcher selects, exactly like rms_norm's four variants (32
// added for the narrow-input arm).
//
// fp32 contraction caveat: glslc keeps a*b+c separate unless RADV's NIR contracts to fma; the
// parity test's rel 1e-5 (the tree's gemv-family tolerance) is the contract.
#version 450
#extension GL_KHR_shader_subgroup_basic : enable
#extension GL_KHR_shader_subgroup_shuffle : enable

layout(local_size_x = GEMV_THREADS) in;

layout(std430, binding = 0) readonly buffer W { float v[]; } bw;   // n_out x n_in, contiguous
layout(std430, binding = 1) readonly buffer X { float v[]; } bx;   // rows x (n_out/rows_per_x) x n_in
layout(std430, binding = 2) buffer Y { float v[]; } by;            // rows x n_out

layout(push_constant) uniform PC { uint n_in; uint n_out; uint rows_per_x; uint pad_; } pc;

shared float part[32];

void main() {
    const uint gid = gl_WorkGroupID.x;
    const uint o   = gid % pc.n_out;          // blockIdx.x: the output row
    const uint tok = gid / pc.n_out;          // blockIdx.y: the token
    const uint tid = gl_LocalInvocationID.x;
    const uint wbase = o * pc.n_in;
    const uint xbase = (tok * (pc.n_out / pc.rows_per_x) + o / pc.rows_per_x) * pc.n_in;
    float acc = 0.0;
    for (uint i = tid; i < pc.n_in; i += GEMV_THREADS)
        acc += bw.v[wbase + i] * bx.v[xbase + i];
    // warp_sum: offsets 16, 8, 4, 2, 1 - the CUDA __shfl_xor chain's order, per warp.
    for (uint s = 16u; s > 0u; s >>= 1u) acc += subgroupShuffleXor(acc, s);
    if ((tid & 31u) == 0u) part[tid >> 5u] = acc;
    barrier();
    float s = 0.0;
    for (uint k = 0u; k < GEMV_THREADS / 32u; ++k) s += part[k];
    if (tid == 0u) by.v[tok * pc.n_out + o] = s;
}
